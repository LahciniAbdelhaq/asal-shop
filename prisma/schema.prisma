// ASAL — modèle de données (PostgreSQL : Neon / Vercel Postgres / Supabase…)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion « pooled »
  directUrl = env("DATABASE_URL_UNPOOLED") // connexion directe (création des tables)
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
}

model Customer {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  firstName        String    @default("")
  lastName         String    @default("")
  phone            String    @default("")
  passwordHash     String?
  address          String    @default("")
  city             String    @default("")
  zip              String    @default("")
  country          String    @default("Maroc")
  acceptsMarketing Boolean   @default(false)
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  orders           Order[]
  reviews          Review[]
}

model Category {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  description    String    @default("")
  image          String    @default("")
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  products       Product[]
}

model Product {
  id             Int            @id @default(autoincrement())
  slug           String         @unique
  title          String
  subtitle       String         @default("") // ex. "250 g" sous le titre des cartes
  description    String         @default("")
  productType    String         @default("")
  vendor         String         @default("ASAL")
  status         String         @default("active") // active | draft
  badge          String         @default("") // ex. "Récolte limitée"
  optionName     String         @default("") // ex. "Poids", "Couleur du coffret"
  featured       Boolean        @default(false)
  sortOrder      Int            @default(0)
  seoTitle       String         @default("")
  seoDescription String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  images         ProductImage[]
  variants       Variant[]
  categories     Category[]
  orderItems     OrderItem[]
  reviews        Review[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id             Int     @id @default(autoincrement())
  productId      Int
  title          String  @default("Défaut")
  sku            String  @default("")
  price          Float
  compareAtPrice Float?
  stock          Int     @default(0)
  trackStock     Boolean @default(true)
  image          String  @default("")
  position       Int     @default(0)
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id            Int         @id @default(autoincrement())
  number        Int         @unique
  customerId    Int?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email         String
  phone         String      @default("")
  firstName     String      @default("")
  lastName      String      @default("")
  address       String      @default("")
  city          String      @default("")
  zip           String      @default("")
  country       String      @default("Maroc")
  note          String      @default("")
  giftMessage   String      @default("")
  subtotal      Float
  discount      Float       @default(0)
  shipping      Float       @default(0)
  total         Float
  promoCode     String      @default("")
  status        String      @default("pending") // pending | confirmed | shipped | delivered | cancelled
  paymentMethod String      @default("cod")
  paymentStatus String      @default("unpaid") // unpaid | paid | refunded
  adminNote     String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    Int?
  title        String
  variantTitle String   @default("")
  image        String   @default("")
  price        Float
  quantity     Int
  meta         String   @default("") // JSON : composition d'un coffret sur mesure, etc.
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String    @default("percent") // percent | fixed | free_shipping
  value       Float     @default(0)
  minSubtotal Float     @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
  email     String
  phone     String   @default("")
  subject   String   @default("")
  body      String
  isRead    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Review {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  rating     Int
  comment    String
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model Page {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  content        String   @default("")
  template       String   @default("default") // default | contact | faq | composer | policy
  isPublished    Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  updatedAt      DateTime @updatedAt
}

model Post {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String   @default("")
  image       String   @default("")
  author      String   @default("ASAL")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Sections de la page d'accueil (ordre, activation, contenu JSON éditable)
model HomeSection {
  id        Int     @id @default(autoincrement())
  type      String
  position  Int     @default(0)
  isEnabled Boolean @default(true)
  data      String  @default("{}")
}

// Réglages globaux : marque, couleurs, typo, menus, livraison… (valeur JSON)
model Setting {
  key   String @id
  value String
}
