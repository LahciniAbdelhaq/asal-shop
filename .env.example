# PostgreSQL (Neon / Vercel Postgres / Supabase). Sur Vercel, l'intégration Neon remplit ces deux variables.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
# Secret des sessions (chaîne longue et aléatoire)
AUTH_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire"
# Vercel Blob (images envoyées depuis le back-office). Rempli automatiquement par Vercel quand un Blob store est relié.
BLOB_READ_WRITE_TOKEN=""
